<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:controls="using:Gml.Launcher.Views.Components"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Design.PreviewWith>
        <Border Background="{StaticResource BackgroundColor}" Padding="20">
            <StackPanel Spacing="30">
                <controls:LogoComponent Classes="Icon" />
                <controls:LogoComponent Classes="TextLogo" />
            </StackPanel>
        </Border>
    </Design.PreviewWith>

    <Style Selector="controls|LogoComponent.Icon">
        <!--  Set Defaults  -->
        <Setter Property="Template">
            <ControlTemplate>
                <Svg
                    Height="{TemplateBinding Size}"
                    Path="/Assets/Images/logo.svg"
                    Width="{TemplateBinding Size}" />
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="controls|LogoComponent.TextLogo">
        <!--  Set Defaults  -->
        <Setter Property="Template">
            <ControlTemplate>
                <StackPanel Orientation="Horizontal" Spacing="15">
                    <Svg
                        Height="{TemplateBinding Size}"
                        Path="/Assets/Images/logo.svg"
                        Width="{TemplateBinding Size}" />
                    <TextBlock
                        FontSize="26"
                        FontWeight="Bold"
                        Foreground="{StaticResource HeadlineColor}"
                        Text="Orlion"
                        VerticalAlignment="Center" />
                </StackPanel>
            </ControlTemplate>
        </Setter>
    </Style>
</Styles>
